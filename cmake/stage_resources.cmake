if(NOT IS_DIRECTORY "${CONFIG_DIR}" OR NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "Public resource directory or output path is missing")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}/config" "${OUTPUT_DIR}/data/doublepinyin")
file(COPY "${CONFIG_DIR}/" DESTINATION "${OUTPUT_DIR}/config")
file(COPY "${CONFIG_DIR}/doublepinyin/" DESTINATION "${OUTPUT_DIR}/data/doublepinyin")
if(RUNTIME_DIR)
    file(COPY "${RUNTIME_DIR}/data/" DESTINATION "${OUTPUT_DIR}/data")
    file(COPY "${RUNTIME_DIR}/config/" DESTINATION "${OUTPUT_DIR}/config")
endif()
