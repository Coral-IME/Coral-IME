function(coral_validate_lexicon_service_base input output)
    string(LENGTH "${input}" length)
    if(length GREATER 8192 OR (input AND NOT input MATCHES "^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9_./~-]*)?$"))
        message(FATAL_ERROR "CORAL_LEXICON_SERVICE_BASE_URL must be an ASCII HTTPS host/base without credentials, query, fragment or unsafe characters")
    endif()
    if(input MATCHES "^https://[^/:]+:([0-9]+)")
        set(port "${CMAKE_MATCH_1}")
        string(REGEX REPLACE "^0+" "" port "${port}")
        string(LENGTH "${port}" digits)
        if(NOT port OR digits GREATER 5 OR port GREATER 65535)
            message(FATAL_ERROR "CORAL_LEXICON_SERVICE_BASE_URL port must be 1..65535")
        endif()
    endif()
    string(REGEX REPLACE "/+$" "" base "${input}")
    set(${output} "${base}" PARENT_SCOPE)
endfunction()
