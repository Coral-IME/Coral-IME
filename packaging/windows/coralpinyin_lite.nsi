!include "${__FILEDIR__}\product_identity.nsh"
; Script generated by the HM NIS Edit Script Wizard.
Unicode True
SetCompressor zlib

; NSIS 3.08+ signs the generated uninstaller before embedding it.
!ifdef CORAL_SIGN_SCRIPT
  !uninstfinalize 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "${CORAL_SIGN_SCRIPT}" -Mode "${CORAL_SIGN_MODE}" -FilePath "%1"' = 0
!endif

; HM NIS Edit Wizard helper defines
!define PRODUCT_NAME "coralpinyin"
!ifdef CORAL_DEMO_PACKAGE
!ifndef CORAL_MANUAL_LAUNCH
!define CORAL_MANUAL_LAUNCH 1
!endif
!define PRODUCT_NAME_CN "珊瑚输入法（演示版）"
!else
!define PRODUCT_NAME_CN "珊瑚输入法"
!endif
!define PRODUCT_PUBLISHER "Coral-IME"
!define PRODUCT_WEB_SITE "https://coralime.cn"
!define PRODUCT_DIR_REGKEY "Software\Microsoft\Windows\CurrentVersion\App Paths\${CORAL_ID_SETTINGS_EXE}"
!define PRODUCT_UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}"
!define PRODUCT_BOOT_KEY "Software\Microsoft\Windows\CurrentVersion\Run"
!define PRODUCT_SETTINGS "${CORAL_ID_SETTINGS_REGISTRY}"
!define PRODUCT_APP_CONFIG "${CORAL_ID_APP_REGISTRY}"
!define PRODUCT_UNINST_ROOT_KEY "HKCU"
!define PRODUCT_UNINST_ROOT_KEY_HKLM "HKLM"
!define SYS_DIR_32_32 "$WINDIR\System32"
!define SYS_DIR_64_32 "$WINDIR\SysWOW64"
!define SYS_DIR_64_64 "$WINDIR\System32"

; 获取传入的参数信息
!ifdef ARCH
    !define ARCH_TYPE "${ARCH}"
!else
    !define ARCH_TYPE "x86"
!endif

!ifdef DBG
    !define DEBUG_MODE "${DBG}"
!else
    !define DEBUG_MODE "0"
!endif

!ifndef PACKAGE_DIR
  !error "Pass PACKAGE_DIR explicitly from the staging tool"
!endif

; MUI 1.67 compatible ------
!include "MUI.nsh"
!include "x64.nsh"
!include "WordFunc.nsh"
!include "nsDialogs.nsh"
!include "TextFunc.nsh"
!include "LogicLib.nsh" 
!include "WinMessages.nsh"
!include "FileFunc.nsh"
!insertmacro LineFind

; MUI Settings
!define MUI_ABORTWARNING
!define MUI_ICON "${PACKAGE_DIR}\res\coral_logo.ico"
!define MUI_UNICON "${PACKAGE_DIR}\res\coral_logo.ico"

; Welcome page
!define MUI_WELCOMEPAGE_TITLE "欢迎使用“$(^Name)”安装向导"
!define MUI_WELCOMEPAGE_TEXT "这个向导将指引您完成“$(^Name)”的安装进程。 \r\n\r\n单击[下一步(N)]继续。"
!insertmacro MUI_PAGE_WELCOME
; 安装前提供可保存的同版本协议和政策，不将安装同意当作可选上传授权。
!define MUI_LICENSEPAGE_TEXT_BOTTOM "选择“我接受”表示接受用户协议；隐私政策供阅读，不授权未来全部上传。"
!define MUI_LICENSEPAGE_BUTTON "我接受"
!insertmacro MUI_PAGE_LICENSE "${PACKAGE_DIR}\legal\安装前须知.txt"

; Directory page
!define MUI_PAGE_HEADER_SUBTEXT "选择“$(^Name)”的安装文件夹。"
!define MUI_DIRECTORYPAGE_TEXT_TOP "安装程序将把“$(^Name)”安装到以下目录。要安装到不同文件夹，请点击[浏览(B)...」并选择其他文件夹。点击「安装(I)」开始安装。"
!define MUI_PAGE_CUSTOMFUNCTION_SHOW SetFocusToButton
!insertmacro MUI_PAGE_DIRECTORY

; Instfiles page
!define MUI_TEXT_INSTALLING_SUBTITLE "“$(^Name)”正在安装，请等候..."
!insertmacro MUI_PAGE_INSTFILES
; Finish page
!define MUI_FINISHPAGE_TITLE "“$(^Name)” 安装程序结束"
!ifdef CORAL_DEMO_PACKAGE
!define MUI_FINISHPAGE_TEXT "“$(^Name) ${PRODUCT_VERSION}” 已经成功安装到本机。\r\n\r\n请从开始菜单打开珊瑚输入法。本演示版仅含小型测试词库，关闭自动更新。\r\n\r\n点击[完成(F)]关闭此安装程序。"
!else
!ifdef CORAL_MANUAL_LAUNCH
!define MUI_FINISHPAGE_TEXT "“$(^Name) ${PRODUCT_VERSION}” 已经成功安装到本机。\r\n\r\n请从开始菜单打开珊瑚输入法。\r\n\r\n点击[完成(F)]关闭此安装程序。"
!else
!define MUI_FINISHPAGE_TEXT "“$(^Name) ${PRODUCT_VERSION}” 已经成功安装到本机。\r\n\r\n点击[完成(F)]关闭此安装程序。"
!endif
!endif
!define MUI_FINISHPAGE_NOREBOOTSUPPORT
!insertmacro MUI_PAGE_FINISH
; Uninstaller pages
!insertmacro MUI_UNPAGE_INSTFILES

; Language files
!insertmacro MUI_LANGUAGE "SimpChinese"
!insertmacro MUI_RESERVEFILE_INSTALLOPTIONS
; MUI end ------

; ------ Exe 文件添加版本信息（这个放到 MUI_LANGUAGE后面，否则中文是乱码） ------
VIProductVersion "${PRODUCT_VERSION}"
;产品名称
VIAddVersionKey /LANG=${LANG_SimpChinese} "ProductName" "${PRODUCT_NAME_CN}"
;备注
;VIAddVersionKey /LANG=${LANG_SimpChinese} "Comments" "备注"
;公司
VIAddVersionKey /LANG=${LANG_SimpChinese} "CompanyName" "${PRODUCT_PUBLISHER}"
;合法商标
;VIAddVersionKey /LANG=${LANG_SimpChinese} "LegalTrademarks" ""
;版权
VIAddVersionKey /LANG=${LANG_SimpChinese} "LegalCopyright" "Copyright (C) 2026 ${PRODUCT_PUBLISHER} and contributors"
;描述
VIAddVersionKey /LANG=${LANG_SimpChinese} "FileDescription" "${PRODUCT_NAME} 安装程序"
;产品版本号
VIAddVersionKey /LANG=${LANG_SimpChinese} "ProductVersion" "${PRODUCT_VERSION}"
;文件版本号
VIAddVersionKey /LANG=${LANG_SimpChinese} "FileVersion" "${PRODUCT_VERSION}"
; ------ Exe 文件添加版本信息 结束 ------
RequestExecutionLevel admin

var BrandingMode
Name "${PRODUCT_NAME_CN}"
BrandingText "${PRODUCT_NAME_CN}$BrandingMode"
!ifndef OUTPUT_FILE
  !error "Pass OUTPUT_FILE explicitly"
!endif
OutFile "${OUTPUT_FILE}"

;InstallDirRegKey ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_DIR_REGKEY}" "";读取注册表中的历史安装位置，由于会携带\${PRODUCT_VERSION}目录层级暂时弃用
ShowInstDetails hide
ShowUnInstDetails hide

!include "FileFunc.nsh"
!insertmacro GetTime
!insertmacro GetParent

; 只删版本号目录；父目录(coralpinyin)为空时再删，避免误删其它版本/用户文件
!macro RemoveProductInstallDirs
  ${If} $PreInstDir != ""
    DetailPrint "正在删除版本安装目录: $PreInstDir"
    RMDir /REBOOTOK /r "$PreInstDir"
  ${EndIf}

  ${If} $DistInstallDir == ""
  ${AndIf} $PreInstDir != ""
    ${GetParent} "$PreInstDir" $DistInstallDir
  ${EndIf}

  ${If} $DistInstallDir != ""
    ; 无 /r：目录非空时 RMDir 会失败并保留，正好符合“有文件就不删”
    DetailPrint "检查产品根目录是否为空后尝试删除: $DistInstallDir"
    RMDir /REBOOTOK "$DistInstallDir"
  ${EndIf}
!macroend

;设置安装路径，方便卸载干净
!define NOW_INST_DIR "$INSTDIR\${PRODUCT_VERSION}";实际安装要进一步安装在版本号\${PRODUCT_VERSION}目录层级下

!if "${ARCH}" == "x86"
  InstallDir "$PROGRAMFILES\${PRODUCT_NAME}"
!else
  InstallDir "$PROGRAMFILES64\${PRODUCT_NAME}"
!endif

var PreInstDir
var PreviousRuntimeDir
var PreviousProductRoot
var DistInstallDir
var LocalLowDir
Var LOG_FILE_PATH
Var TempValue

!macro CopyLanguageFile langCode
  ; mui/qm removed from build - skip
!macroend

!macro CopyDataFilesToPath targetPath
  Push "${targetPath}"
  Call CopyDataFiles
!macroend

!macro CopyFileIfMissing _SourceFile _TargetFile
  Push "${_SourceFile}"
  Push "${_TargetFile}"
  Call CopyFileWithLog
!macroend

Section "MainSection" SEC01
  ${DisableX64FSRedirection}
  ; HKLM Uninstall 统一使用 32 位视图
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "IsReinstalling" "1"
  ; 兼容旧 TSF：安装阶段同时写入 HKCU 的 IsReinstalling
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "IsReinstalling" "1"
  ; 兼容旧 TSF：保留一个最小的 HKCU Uninstall，用于读取 DisplayIcon 拉活主进程
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayIcon" "${NOW_INST_DIR}\${CORAL_ID_SETTINGS_EXE}"
  ReadRegStr $PreInstDir ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "Dir"
  ReadRegStr $DistInstallDir ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "InstallDir"
  ${If} $PreInstDir == ""
  ${OrIfNot} ${FileExists} "$PreInstDir\*.*"
    ReadRegStr $PreInstDir ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "Dir"
    ReadRegStr $DistInstallDir ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "InstallDir"
  ${EndIf}
  StrCpy $PreviousRuntimeDir $PreInstDir
  StrCpy $PreviousProductRoot $DistInstallDir

  ; 设置LocalLow目录路径
  StrCpy $LocalLowDir "$LOCALAPPDATA\..\LocalLow"
  DetailPrint "检查并停止旧版本服务..."
  InitPluginsDir
  File /oname=$PLUGINSDIR\product_identity.psd1 "${__FILEDIR__}\product_identity.psd1"
  File /oname=$PLUGINSDIR\prepare_install.ps1 "${__FILEDIR__}\prepare_install.ps1"
  nsExec::ExecToLog 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$PLUGINSDIR\prepare_install.ps1" -PreviousInstallDir "$PreInstDir" -PreviousProductRoot "$PreviousProductRoot" -TargetInstallDir "${NOW_INST_DIR}"'
  Pop $0
  ${If} $0 != 0
    MessageBox MB_ICONSTOP "旧版 CORAL 进程或服务未能退出，安装已停止。请关闭相关程序后重试。"
    Abort
  ${EndIf}
  Call KillRunningProc
  nsExec::ExecToLog 'sc delete ${CORAL_ID_SERVICE_NAME}'
  Call delCover

  CreateDirectory "$LocalLowDir\coralpinyin\log\APP"
  System::Call "kernel32::GetCurrentProcessId() i .R0"
  StrCpy $LOG_FILE_PATH "$LocalLowDir\coralpinyin\log\APP\install_$R0.log"


  SetOutPath "${NOW_INST_DIR}"
  File "${PACKAGE_DIR}\${CORAL_ID_SETTINGS_EXE}"
  File "${PACKAGE_DIR}\${CORAL_ID_UPDATE_EXE}"
  File "${PACKAGE_DIR}\${CORAL_ID_DIAGNOSTIC_EXE}"
  File "${PACKAGE_DIR}\${CORAL_ID_SERVICE_EXE}"
  File "${PACKAGE_DIR}\${CORAL_ID_SESSION_HOST_EXE}"
  File "${PACKAGE_DIR}\${CORAL_ID_RENDERER_EXE}"
  File "${PACKAGE_DIR}\res\pinyin.ico"
  SetOutPath "${NOW_INST_DIR}\res"
  File "${PACKAGE_DIR}\res\zh.ico"
  File "${PACKAGE_DIR}\res\en.ico"
  File "${PACKAGE_DIR}\res\A.ico"
  File "${PACKAGE_DIR}\res\coral_logo.ico"
  SetOutPath "${NOW_INST_DIR}\res\skins"
  File "${PACKAGE_DIR}\res\skins\*.jpg"
  SetOutPath "${NOW_INST_DIR}"

  CreateDirectory "$SMPROGRAMS\${PRODUCT_NAME_CN}"
  CreateShortCut "$SMPROGRAMS\${PRODUCT_NAME_CN}\${PRODUCT_NAME_CN}.lnk" "${NOW_INST_DIR}\${CORAL_ID_SETTINGS_EXE}" "-showsetting"
  ; SSL/crypto/kdcsdk removed from build - skip

  ${if} ${RunningX64}
    SetOutPath "${SYS_DIR_64_32}"
    File "${PACKAGE_DIR}\${CORAL_ID_TSF_X86_DLL}"
    SetOutPath "${SYS_DIR_64_64}"
    File "${PACKAGE_DIR}\${CORAL_ID_TSF_X64_DLL}"
  ${Else}
    SetOutPath "${SYS_DIR_32_32}"
    File "${PACKAGE_DIR}\${CORAL_ID_TSF_X86_DLL}"
	  SetOutPath "${SYS_DIR_64_64}"
    File "${PACKAGE_DIR}\${CORAL_ID_TSF_X64_DLL}"
  ${EndIf}
  !if "${DEBUG_MODE}" == "0"
    ${if} ${RunningX64}
      SetOutPath "${SYS_DIR_64_64}"
      IfFileExists "${SYS_DIR_64_64}\vcruntime140.dll" skip_vc64_runtime
;[lite]         File "${PACKAGE_DIR}\msvcrt_x64\vcruntime140.dll"
      skip_vc64_runtime:
      IfFileExists "${SYS_DIR_64_64}\vcruntime140_1.dll" skip_vc64_runtime1
;[lite]         File "${PACKAGE_DIR}\msvcrt_x64\vcruntime140_1.dll"
      skip_vc64_runtime1:
      IfFileExists "${SYS_DIR_64_64}\msvcp140.dll" skip_msvcp64
;[lite]         File "${PACKAGE_DIR}\msvcrt_x64\msvcp140.dll"
      skip_msvcp64:
      SetOutPath "${SYS_DIR_64_32}"
      IfFileExists "${SYS_DIR_64_32}\vcruntime140.dll" skip_vc32_runtime
;[lite]         File "${PACKAGE_DIR}\msvcrt_x86\vcruntime140.dll"
      skip_vc32_runtime:
      IfFileExists "${SYS_DIR_64_32}\msvcp140.dll" skip_msvcp32
;[lite]         File "${PACKAGE_DIR}\msvcrt_x86\msvcp140.dll"
      skip_msvcp32:
    ${Else}
      SetOutPath "${SYS_DIR_32_32}"
      IfFileExists "${SYS_DIR_32_32}\vcruntime140.dll" skip_vc32_on_32
;[lite]         File "${PACKAGE_DIR}\msvcrt_x86\vcruntime140.dll"
      skip_vc32_on_32:
      IfFileExists "${SYS_DIR_32_32}\msvcp140.dll" skip_msvcp32_on_32
;[lite]         File "${PACKAGE_DIR}\msvcrt_x86\msvcp140.dll"
      skip_msvcp32_on_32:
    ${EndIf}
    SetOutPath "${NOW_INST_DIR}"
    ; 递归复制 msvcrt_x64 和 msvcrt_x86 整个文件夹 保留这些dll 方便日后恢复
;[lite]     File /r "${PACKAGE_DIR}\msvcrt_x64"
;[lite]     File /r "${PACKAGE_DIR}\msvcrt_x86"
  !endif
  SetOutPath "${NOW_INST_DIR}"
  ; Engine core is statically linked into the host and settings executable.
  ; Keep the source and third-party terms available offline with the binaries.
  File "${PACKAGE_DIR}\LICENSE"
  File "${PACKAGE_DIR}\LICENSING.md"
  File "${PACKAGE_DIR}\THIRD_PARTY_NOTICES.md"
  File "${PACKAGE_DIR}\THIRD_PARTY_MANIFEST.json"
  SetOutPath "${NOW_INST_DIR}\tools"
  File "${PACKAGE_DIR}\tools\ime_dictionary_tool.py"
  SetOutPath "${NOW_INST_DIR}\legal"
  File "${PACKAGE_DIR}\legal\*.*"
  SetOutPath "${NOW_INST_DIR}\licenses"
  File "${PACKAGE_DIR}\licenses\*.*"
  SetOutPath "${NOW_INST_DIR}"
  ; DbgHelp is provided by the Windows SDK/system DLL; do not redistribute it.

  ; 在安装目录创建config文件夹和配置模板（供所有用户使用）
  CreateDirectory "${NOW_INST_DIR}\config"
  SetOutPath "${NOW_INST_DIR}\config"
  File "${PACKAGE_DIR}\config\coralpinyinConfig.ini"
  
  ; 创建安装用户的config文件夹和配置文件
  Var /GLOBAL CoralPinyinConfigFile
  StrCpy $CoralPinyinConfigFile "$LocalLowDir\coralpinyin\config\coralpinyinConfig.ini"

  ; 确保配置文件所在的目录存在
  CreateDirectory "$LocalLowDir\coralpinyin\config"
  SetOutPath "$LocalLowDir\coralpinyin\config"

  ; 删除旧的配置文件
  IfFileExists "$LocalLowDir\coralpinyin\config\coralpinyin_config.ini" 0 +2
    Delete "$LocalLowDir\coralpinyin\config\coralpinyin_config.ini"
  ;如果文件存在，则直接跳过；仅当文件不存在时才写入
  IfFileExists "$CoralPinyinConfigFile" skip_write  
  CopyFiles "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "$CoralPinyinConfigFile"
  ;文件存在时跳转到这里
  skip_write:
  ; 更新安装目录的配置模板
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "app" "Version" "${PRODUCT_VERSION}"
  
  ; 同时更新当前用户的配置文件
  WriteINIStr "$CoralPinyinConfigFile" "log" "level" "2"
  WriteINIStr "$CoralPinyinConfigFile" "log" "maxLogFileSize" "10"
  WriteINIStr "$CoralPinyinConfigFile" "log" "keepLogFileCount" "2"
  WriteINIStr "$CoralPinyinConfigFile" "app" "Version" "${PRODUCT_VERSION}"
  WriteINIStr "$CoralPinyinConfigFile" "app" "CloudLexiconPath" "cloud\"
  WriteINIStr "$CoralPinyinConfigFile" "ErrorDialog" "CPinyinModelInitErrorShown" "false"

  ; 将安装包内的源配置文件解压到临时目录，并重命名以防冲突
  SetOutPath "$PLUGINSDIR"
  File "/oname=source.ini" "${PACKAGE_DIR}\config\coralpinyinConfig.ini"

  ; 从目标配置文件中删除旧的 [LexiconFiles] 节
  DeleteINISec "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "LexiconFiles"
  DeleteINISec "$CoralPinyinConfigFile" "LexiconFiles"

  ; 逐一读取源配置文件中的MD5值，并同时写入到安装目录模板和当前用户配置
  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "LexiconFiles" "BushouTrie"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "LexiconFiles" "BushouTrie" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "LexiconFiles" "BushouTrie" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "LexiconFiles" "BushouData"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "LexiconFiles" "BushouData" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "LexiconFiles" "BushouData" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "LexiconFiles" "StrokeTrie"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "LexiconFiles" "StrokeTrie" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "LexiconFiles" "StrokeTrie" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "LexiconFiles" "StrokeData"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "LexiconFiles" "StrokeData" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "LexiconFiles" "StrokeData" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "LexiconFiles" "BigramMphf"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "LexiconFiles" "BigramMphf" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "LexiconFiles" "BigramMphf" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "LexiconFiles" "BigramData"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "LexiconFiles" "BigramData" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "LexiconFiles" "BigramData" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "LexiconFiles" "BigramWsfa"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "LexiconFiles" "BigramWsfa" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "LexiconFiles" "BigramWsfa" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "LexiconFiles" "EnglishData"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "LexiconFiles" "EnglishData" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "LexiconFiles" "EnglishData" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "LexiconFiles" "EnglishMarisa"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "LexiconFiles" "EnglishMarisa" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "LexiconFiles" "EnglishMarisa" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "LexiconFiles" "PrimaryData"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "LexiconFiles" "PrimaryData" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "LexiconFiles" "PrimaryData" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "LexiconFiles" "PrimaryMarisa"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "LexiconFiles" "PrimaryMarisa" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "LexiconFiles" "PrimaryMarisa" "$TempValue"



  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "LexiconFiles" "CorrectionData"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "LexiconFiles" "CorrectionData" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "LexiconFiles" "CorrectionData" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "LexiconFiles" "CharLMData"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "LexiconFiles" "CharLMData" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "LexiconFiles" "CharLMData" "$TempValue"


  ; 同步 [placeholder] 节（升级用户也写入安装包内的占位符配置）
  DeleteINISec "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder"
  DeleteINISec "$CoralPinyinConfigFile" "placeholder"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "idea64"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "idea64" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "idea64" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "pycharm64"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "pycharm64" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "pycharm64" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "clion64"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "clion64" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "clion64" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "studio64"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "studio64" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "studio64" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "taskmgr"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "taskmgr" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "taskmgr" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "winstore.app"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "winstore.app" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "winstore.app" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "et"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "et" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "et" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "excel"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "excel" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "excel" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "qqmusic"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "qqmusic" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "qqmusic" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "douyin"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "douyin" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "douyin" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "webstorm64"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "webstorm64" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "webstorm64" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "phpstorm64"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "phpstorm64" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "phpstorm64" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "goland64"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "goland64" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "goland64" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "rubymine64"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "rubymine64" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "rubymine64" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "rider64"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "rider64" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "rider64" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "rustrover64"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "rustrover64" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "rustrover64" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "dataspell64"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "dataspell64" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "dataspell64" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "mailmaster"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "mailmaster" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "mailmaster" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "coralpdf"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "coralpdf" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "coralpdf" "$TempValue"

  ReadINIStr $TempValue "$PLUGINSDIR\source.ini" "placeholder" "msedgewebview2"
  WriteINIStr "${NOW_INST_DIR}\config\coralpinyinConfig.ini" "placeholder" "msedgewebview2" "$TempValue"
  WriteINIStr "$CoralPinyinConfigFile" "placeholder" "msedgewebview2" "$TempValue"

  ; 清理临时文件
  Delete "$PLUGINSDIR\source.ini"


  ; 1. 设置目录的低完整性级别
  nsExec::Exec 'icacls "$LocalLowDir\coralpinyin" /setintegritylevel (OI)(CI)L'
  ; 2. 为 Everyone 和 所有UWP应用 授予完全控制权限
  nsExec::Exec 'icacls "$LocalLowDir\coralpinyin" /grant "Everyone:(OI)(CI)F" /grant "*S-1-15-2-1:(OI)(CI)F'
  ; 3. 清理旧版本LocalLow下的系统数据目录
  RMDir /r "$LocalLowDir\coralpinyin\data"
  ; 复制data目录下的文件和文件夹到安装目录（系统词库所有用户共享）
  !insertmacro CopyDataFilesToPath "${NOW_INST_DIR}"
  ; 4. 为安装目录添加UWP应用读取权限（只给读取权限，不给写入权限）
  nsExec::Exec 'icacls "${NOW_INST_DIR}" /grant "*S-1-15-2-1:(OI)(CI)RX"'
  
  ; qt dir removed from build - skip
  !insertmacro CopyLanguageFile zh_CN

  CreateDirectory "${NOW_INST_DIR}\tsf"
  SetOutPath "${NOW_INST_DIR}\tsf"
  File "${PACKAGE_DIR}\${CORAL_ID_TSF_X86_DLL}"
  File "${PACKAGE_DIR}\${CORAL_ID_TSF_X64_DLL}"

  ; 再次检查tsf文件是否存在
  ${If} ${RunningX64}
    !insertmacro CopyFileIfMissing "${NOW_INST_DIR}\tsf\${CORAL_ID_TSF_X86_DLL}" "${SYS_DIR_64_32}\${CORAL_ID_TSF_X86_DLL}"
    !insertmacro CopyFileIfMissing "${NOW_INST_DIR}\tsf\${CORAL_ID_TSF_X64_DLL}" "${SYS_DIR_64_64}\${CORAL_ID_TSF_X64_DLL}"
  ${Else}
    !insertmacro CopyFileIfMissing "${NOW_INST_DIR}\tsf\${CORAL_ID_TSF_X86_DLL}" "${SYS_DIR_32_32}\${CORAL_ID_TSF_X86_DLL}"
    !insertmacro CopyFileIfMissing "${NOW_INST_DIR}\tsf\${CORAL_ID_TSF_X64_DLL}" "${SYS_DIR_64_64}\${CORAL_ID_TSF_X64_DLL}"
  ${EndIf}

SectionEnd

Section -AdditionalIcons
  ; HKLM Uninstall 统一使用 32 位视图
  ReadRegStr $PreInstDir ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "Dir"
  ReadRegStr $DistInstallDir ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "InstallDir"

  WriteIniStr "${NOW_INST_DIR}\${PRODUCT_NAME}.url" "InternetShortcut" "URL" "${PRODUCT_WEB_SITE}"
  CreateShortCut "$SMPROGRAMS\${PRODUCT_NAME_CN}\Website.lnk" "${NOW_INST_DIR}\${PRODUCT_NAME}.url"
  CreateShortCut "$SMPROGRAMS\${PRODUCT_NAME_CN}\Uninstall.lnk" "${NOW_INST_DIR}\uninst.exe"
SectionEnd

!define STRTOFIND  "dataDir="
!define STRTOREPL  "dataDir=$LOCALAPPDATA\..\LocalLow\${PRODUCT_NAME}\data"
Function LineFindCallback
    ${WordReplace} "${STRTOREPL}" "\" "\\" "+" $R0
    StrLen $0 "${STRTOFIND}"
    StrCpy $1 "$R9" $0
    StrCmp $1 "${STRTOFIND}" 0 End
    StrCpy $R9 "$R0$\r$\n"
    End:
    Push $0
FunctionEnd

Section -Post
  ${DisableX64FSRedirection}
  ; HKLM Uninstall 统一使用 32 位视图
  ReadRegStr $PreInstDir ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "Dir"
  ReadRegStr $DistInstallDir ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "InstallDir"

  ; 设置LocalLow目录路径
  StrCpy $LocalLowDir "$LOCALAPPDATA\..\LocalLow"

  WriteUninstaller "${NOW_INST_DIR}\uninst.exe"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_DIR_REGKEY}" "" "${NOW_INST_DIR}\${CORAL_ID_SETTINGS_EXE}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${CORAL_ID_LAUNCHER_REGISTRY}" "${CORAL_ID_INSTALL_PATH_VALUE}" "${NOW_INST_DIR}\${CORAL_ID_SETTINGS_EXE}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_BOOT_KEY}" "coralpinyin" '"${NOW_INST_DIR}\${CORAL_ID_SETTINGS_EXE}" --startup-type=0'

  ; 卸载项信息写入 HKLM（统一使用 32 位视图）
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "Dir" "${NOW_INST_DIR}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "InstallDir" "$INSTDIR"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "DisplayName" "$(^Name)"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "UninstallString" "${NOW_INST_DIR}\uninst.exe"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "DisplayIcon" "${NOW_INST_DIR}\${CORAL_ID_SETTINGS_EXE}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "DisplayVersion" "${PRODUCT_VERSION}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "URLInfoAbout" "${PRODUCT_WEB_SITE}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "Publisher" "${PRODUCT_PUBLISHER}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "CrashNotification" "false";默认不启用崩溃弹窗
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "DumpWithFullMemory" "false";默认不启用MiniDumpWithFullMemory

  ; 兼容旧 TSF / 旧包降级：HKCU 保留 DisplayIcon（旧 TSF 拉活）和 Dir（旧包降级时杀进程/清理）
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayIcon" "${NOW_INST_DIR}\${CORAL_ID_SETTINGS_EXE}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "Dir" "${NOW_INST_DIR}"

  ; 写入 HKLM app 配置
  ; 写入 32 位视图（落到 WOW6432Node）
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_APP_CONFIG}" "${CORAL_ID_INSTALL_PATH_VALUE}" "${NOW_INST_DIR}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_APP_CONFIG}" "DisplayVersion" "${PRODUCT_VERSION}"

  ; ${LineFind} "${NOW_INST_DIR}\appconfig.ini" "${NOW_INST_DIR}\appconfig.ini" "1:-1" "LineFindCallback"
  ${if} ${RunningX64}
    ExecWait '${SYS_DIR_64_32}\regsvr32.exe /s "${SYS_DIR_64_32}\${CORAL_ID_TSF_X86_DLL}"'
    ExecWait '${SYS_DIR_64_64}\regsvr32.exe /s "${SYS_DIR_64_64}\${CORAL_ID_TSF_X64_DLL}"'
  ${Else}
    ExecWait '${SYS_DIR_32_32}\regsvr32.exe /s "${SYS_DIR_32_32}\${CORAL_ID_TSF_X86_DLL}"'
  ${EndIf}
  DetailPrint "正在注册 ${PRODUCT_NAME_CN}服务..."
  nsExec::ExecToLog 'sc create ${CORAL_ID_SERVICE_NAME} binPath= "${NOW_INST_DIR}\${CORAL_ID_SERVICE_EXE}" start= auto DisplayName= "${PRODUCT_NAME_CN}服务"'
  Pop $0
  ${If} $0 == 0
    DetailPrint "${PRODUCT_NAME_CN}服务注册成功"
    nsExec::ExecToLog 'sc description ${CORAL_ID_SERVICE_NAME} "${PRODUCT_NAME_CN}服务，停用可能会导致部分功能无法正常使用。"'
  DetailPrint "正在配置服务权限..."
  nsExec::ExecToLog 'sc sdset ${CORAL_ID_SERVICE_NAME} "D:(A;;CCLCSWRPWPDTLOCRRC;;;SY)(A;;CCDCLCSWRPWPDTLOCRSDRCWDWO;;;BA)(A;;CCLCSWRPWPLOCRRC;;;IU)(A;;CCLCSWRPWPLOCRRC;;;AC)S:(ML;;NW;;;LW)"'
  Pop $0
  ${If} $0 == 0
    DetailPrint "服务权限配置成功"
  ${Else}
    DetailPrint "服务权限配置失败，错误代码: $0（不影响服务运行）"
  ${EndIf}
    nsExec::ExecToLog 'sc start ${CORAL_ID_SERVICE_NAME}'
    Pop $0
    ${If} $0 == 0
      DetailPrint "${PRODUCT_NAME_CN}服务启动成功"
    ${Else}
      DetailPrint "${PRODUCT_NAME_CN}服务启动失败，错误代码: $0"
    ${EndIf}
  ${Else}
    DetailPrint "${PRODUCT_NAME_CN}服务注册失败，错误代码: $0"
  ${EndIf}
  ; 旧 TSF 可能在文件复制期间重启了旧渲染器。新安装路径写入后再清理一次。
  nsExec::ExecToLog 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$PLUGINSDIR\prepare_install.ps1" -PreviousInstallDir "$PreviousRuntimeDir" -PreviousProductRoot "$PreviousProductRoot" -TargetInstallDir "${NOW_INST_DIR}" -ProcessesOnly'
  Pop $0
  ${If} $0 != 0
    MessageBox MB_ICONEXCLAMATION "安装已完成，但旧版进程仍在运行。请注销或重启 Windows 后使用新版本。"
  ${EndIf}
  ; 演示包由用户从开始菜单启动，不嵌入本地额外安装的启动插件。
!ifndef CORAL_MANUAL_LAUNCH
  Call EndRun
!endif
  ; 清理安装标记：HKLM+ HKCU
  DeleteRegValue ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "IsReinstalling"
  DeleteRegValue ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "IsReinstalling"
SectionEnd
!macro ACQUIRE_MUTEX_IMPL
  System::Call 'kernel32::CreateMutex(p 0, i 0, t "${CORAL_ID_INSTALLATION_MUTEX}") p .r0 ?e'
  Pop $1
  ${If} $1 == 183
    MessageBox MB_ICONEXCLAMATION|MB_OK "已有安装/卸载程序在运行，请先关闭后再重试。"
    Abort
  ${EndIf}
  ${If} $1 != 0
    MessageBox MB_ICONSTOP|MB_OK "系统错误，安装/卸载程序无法继续。$\r$\n可尝试重启后再重试。"
    Abort
  ${EndIf}
!macroend
; 安装程序和卸载程序的初始化
Function .onInit
  StrCpy $BrandingMode "安装程序"
  !insertmacro ACQUIRE_MUTEX_IMPL
FunctionEnd
Function un.onInit
  StrCpy $BrandingMode "卸载程序"
  !insertmacro ACQUIRE_MUTEX_IMPL
  MessageBox MB_ICONQUESTION|MB_YESNO|MB_DEFBUTTON2 "确定是否要删除$(^Name)中的所有数据？" IDYES +2
  Quit
FunctionEnd

Section Uninstall
  ${DisableX64FSRedirection}
  ; 卸载阶段读取/清理标记：HKLM+ HKCU
  DeleteRegValue ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "IsReinstalling"
  ReadRegStr $PreInstDir ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "Dir"
  ReadRegStr $DistInstallDir ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "InstallDir"
  DeleteRegValue ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "IsReinstalling"

  ; 清理运行期配置：HermesIME\engine\app
  DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_APP_CONFIG}"
  ; 兼容清理历史残留：旧版本可能写入过 HKCU 的 appconfig
  DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_APP_CONFIG}"

  ; 设置LocalLow目录路径
  StrCpy $LocalLowDir "$LOCALAPPDATA\..\LocalLow"

  Call un.KillRunningProc
  ; 停止并删除 ${PRODUCT_NAME_CN}服务
  DetailPrint "正在停止 ${PRODUCT_NAME_CN}服务..."
  nsExec::ExecToLog 'sc stop ${CORAL_ID_SERVICE_NAME}'
  DetailPrint "正在删除 ${PRODUCT_NAME_CN}服务..."
  nsExec::ExecToLog 'sc delete ${CORAL_ID_SERVICE_NAME}'

  Delete "$SMPROGRAMS\${PRODUCT_NAME_CN}\Uninstall.lnk"
  Delete "$SMPROGRAMS\${PRODUCT_NAME_CN}\Website.lnk"

  Delete "$SMPROGRAMS\${PRODUCT_NAME_CN}\${PRODUCT_NAME_CN}.lnk"

  ; 这里在卸载程序时不再删除用户词典
  RMDir /REBOOTOK /r "$LocalLowDir\coralpinyin\config"
  RMDir /REBOOTOK /r "$LocalLowDir\coralpinyin\data"
  RMDir /REBOOTOK /r "$LocalLowDir\coralpinyin\log"
  RMDir /REBOOTOK /r "$LocalLowDir\coralpinyin\cloud"
  RMDir /REBOOTOK /r "$LocalLowDir\coralpinyin\skin"

  RMDir /REBOOTOK /r "$SMPROGRAMS\${PRODUCT_NAME_CN}"

  Delete /REBOOTOK "$APPDATA\${PRODUCT_NAME}\log\uilogic\uilogic.log"
  RMDir /REBOOTOK /r "$APPDATA\${PRODUCT_NAME}\log\uilogic"

  Delete /REBOOTOK "$APPDATA\${PRODUCT_NAME}\log\langengine.log"
  RMDir /REBOOTOK /r "$APPDATA\${PRODUCT_NAME}\log\engine"
  RMDir /REBOOTOK /r "$APPDATA\${PRODUCT_NAME}\log"

  !insertmacro RemoveProductInstallDirs

  DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}"
  DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_DIR_REGKEY}"
  ; 全局卸载项清理
  DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}"
  DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${CORAL_ID_LAUNCHER_REGISTRY}"
  DeleteRegValue ${PRODUCT_UNINST_ROOT_KEY} ${PRODUCT_BOOT_KEY} "coralpinyin"
  SetAutoClose true
SectionEnd

Function un.onUninstSuccess
  ; HKLM Uninstall 统一使用 32 位视图
  ReadRegStr $PreInstDir ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "Dir"
  HideWindow
  MessageBox MB_ICONINFORMATION|MB_OK "$(^Name) 现已从您的计算机移除"
FunctionEnd

!ifndef CORAL_MANUAL_LAUNCH
Function EndRun
  ShellExecAsUser::ShellExecAsUser "" "${NOW_INST_DIR}\${CORAL_ID_SETTINGS_EXE}" "--startup-type=3"
FunctionEnd
!endif

Function KillRunningProc
  ; HKLM Uninstall 统一使用 32 位视图，优先读 HKLM
  ReadRegStr $PreInstDir ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "Dir"
  ; 如果 HKLM 没有 或 目录不存在，fallback 读 HKCU
  ${if} $PreInstDir == ""
  ${OrIfNot} ${FileExists} "$PreInstDir\*.*"
    ReadRegStr $PreInstDir ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "Dir"
  ${EndIf}
  ${if} $PreInstDir != ""
    ${GetTime} "" "L" $0 $1 $2 $3 $4 $5 $6
    DetailPrint "currentdatetime=$2$1$0$4$5$6"

	${if} ${RunningX64}
      ExecWait '${SYS_DIR_64_32}\regsvr32.exe /u /s "${SYS_DIR_64_32}\${CORAL_ID_TSF_X86_DLL}"'
      Rename "${SYS_DIR_64_32}\${CORAL_ID_TSF_X86_DLL}" "${SYS_DIR_64_32}\coraltsf32_$2$1$0$4$5$6.dll"
      Delete /REBOOTOK "${SYS_DIR_64_32}\coraltsf32_$2$1$0$4$5$6.dll"
      ExecWait '${SYS_DIR_64_64}\regsvr32.exe /u /s "${SYS_DIR_64_64}\${CORAL_ID_TSF_X64_DLL}"'
      Rename "${SYS_DIR_64_64}\${CORAL_ID_TSF_X64_DLL}" "${SYS_DIR_64_64}\coraltsf64_$2$1$0$4$5$6.dll"
      Delete /REBOOTOK "${SYS_DIR_64_64}\coraltsf64_$2$1$0$4$5$6.dll"
      Delete /REBOOTOK "${SYS_DIR_64_64}\langengine.dll"
    ${Else}
      ExecWait '${SYS_DIR_32_32}\regsvr32.exe /u /s "${SYS_DIR_32_32}\${CORAL_ID_TSF_X86_DLL}"'
      Rename "${SYS_DIR_32_32}\${CORAL_ID_TSF_X86_DLL}" "${SYS_DIR_32_32}\coraltsf32_$2$1$0$4$5$6.dll"
      Delete /REBOOTOK "${SYS_DIR_32_32}\coraltsf32_$2$1$0$4$5$6.dll"
    ${EndIf}

  ${EndIf}
FunctionEnd

Function delCover
  ; HKLM Uninstall 统一使用 32 位视图，优先读 HKLM
  ReadRegStr $PreInstDir ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "Dir"
  ReadRegStr $DistInstallDir ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "InstallDir"
  ; 如果 HKLM 没有 或 目录不存在，fallback 读 HKCU
  ${if} $PreInstDir == ""
  ${OrIfNot} ${FileExists} "$PreInstDir\*.*"
    ReadRegStr $PreInstDir ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "Dir"
    ReadRegStr $DistInstallDir ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "InstallDir"
  ${EndIf}

  ; 设置LocalLow目录路径
  StrCpy $LocalLowDir "$LOCALAPPDATA\..\LocalLow"

  ${if} $PreInstDir != ""
    !insertmacro RemoveProductInstallDirs

    RMDir /REBOOTOK /r "$SMPROGRAMS\${PRODUCT_NAME_CN}"

    RMDir /REBOOTOK /r "$APPDATA\${PRODUCT_NAME}\log"

    ; 清理旧卸载项
    DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}"
    DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_DIR_REGKEY}"
    ; 兼容旧 TSF：升级覆盖安装时不删除 HKCU Uninstall 整个键
    ; 仅清理 展示/卸载字段，避免控制面板出现重复卸载项
    DeleteRegValue ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayName"
    DeleteRegValue ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "Publisher"
    DeleteRegValue ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "UninstallString"
    DeleteRegValue ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "URLInfoAbout"
    DeleteRegValue ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayVersion"
    ; 清理旧版本遗留字段
    DeleteRegValue ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "Dir"
    DeleteRegValue ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "InstallDir"
    WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayIcon" "${NOW_INST_DIR}\${CORAL_ID_SETTINGS_EXE}"

    DeleteRegValue ${PRODUCT_UNINST_ROOT_KEY} ${PRODUCT_BOOT_KEY} "coralpinyin"

  ${EndIf}
FunctionEnd

Function CopyDataFiles
  Pop $R0 ; 目标路径

  SetOutPath "$R0\data"
  File "${PACKAGE_DIR}\data\bushou.marisa"
  File "${PACKAGE_DIR}\data\bushou.dat"
  File "${PACKAGE_DIR}\data\stroke.marisa"
  File "${PACKAGE_DIR}\data\stroke.dat"
  File "${PACKAGE_DIR}\data\dw.coral"
;[lite]   File "${PACKAGE_DIR}\data\s2t.json"
;[lite]   File "${PACKAGE_DIR}\data\STPhrases.ocd2"
;[lite]   File "${PACKAGE_DIR}\data\STCharacters.ocd2"

  SetOutPath "$R0\data\opencc"
  File "${PACKAGE_DIR}\data\opencc\*.*"

  SetOutPath "$R0\data\generallexicon"
;[lite]   File "${PACKAGE_DIR}\data\generallexicon\bigram.mphf"
;[lite]   File "${PACKAGE_DIR}\data\generallexicon\bigram.dat"
;[lite]   File "${PACKAGE_DIR}\data\generallexicon\bigram.wsfa"
  File "${PACKAGE_DIR}\data\generallexicon\english.dat"
  File "${PACKAGE_DIR}\data\generallexicon\english.marisa"
  File "${PACKAGE_DIR}\data\generallexicon\correction_pinyin_model.dat"
  File "${PACKAGE_DIR}\data\generallexicon\char_lm.dat"
  ; compressed coral_lexicon.csv + coral_languagemodel.csv (decompressed at install time)
  File "${PACKAGE_DIR}\data\generallexicon\dictionary_bundle.dictpack.lzma2"
  File "${PACKAGE_DIR}\data\generallexicon\coral_lexicon_builder.exe"
  File "${PACKAGE_DIR}\data\generallexicon\coral_bundle_decoder.exe"

  ; Decompress bundle and generate languagemodel.coral + mainlexicon.coral (no Python needed)
  ; NOTE: $OUTDIR is already "$R0\data\generallexicon" after SetOutPath above
  DetailPrint "Decompressing dictionary data..."
  nsExec::ExecToLog '"$OUTDIR\coral_bundle_decoder.exe" "$OUTDIR\dictionary_bundle.dictpack.lzma2" "$OUTDIR\coral_lexicon.csv" "$OUTDIR\coral_languagemodel.csv"'
  Pop $0
  ${If} $0 != 0
    DetailPrint "WARNING: dictionary decompression failed (code $0), languagemodel.coral/mainlexicon.coral will not be generated"
  ${Else}
    DetailPrint "Generating languagemodel.coral and mainlexicon.coral..."
    nsExec::ExecToLog '"$OUTDIR\coral_lexicon_builder.exe" --csv "$OUTDIR\coral_lexicon.csv" "$OUTDIR\coral_languagemodel.csv" "$OUTDIR"'
    Pop $0
    ${If} $0 != 0
      DetailPrint "WARNING: coral_lexicon_builder failed (code $0)"
    ${Else}
      DetailPrint "languagemodel.coral and mainlexicon.coral generated successfully"
    ${EndIf}
    ; Clean up intermediate files
    Delete "$OUTDIR\coral_lexicon.csv"
    Delete "$OUTDIR\coral_languagemodel.csv"
    Delete "$OUTDIR\dictionary_bundle.dictpack.lzma2"
    Delete "$OUTDIR\coral_lexicon_builder.exe"
    Delete "$OUTDIR\coral_bundle_decoder.exe"
  ${EndIf}

  SetOutPath "$R0\data\doublepinyin"
  File "${PACKAGE_DIR}\data\doublepinyin\*.ini"
FunctionEnd

Function un.KillRunningProc
  ; HKLM Uninstall 统一使用 32 位视图，优先读 HKLM
  ReadRegStr $PreInstDir ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "Dir"
  ; 如果 HKLM 没有 或 目录不存在，fallback 读 HKCU
  ${if} $PreInstDir == ""
  ${OrIfNot} ${FileExists} "$PreInstDir\*.*"
    ReadRegStr $PreInstDir ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "Dir"
  ${EndIf}
  ${if} $PreInstDir != ""
    ${GetTime} "" "L" $0 $1 $2 $3 $4 $5 $6
    DetailPrint "currentdatetime=$2$1$0$4$5$6"

	${if} ${RunningX64}
      ExecWait '${SYS_DIR_64_32}\regsvr32.exe /u /s "${SYS_DIR_64_32}\${CORAL_ID_TSF_X86_DLL}"'
      Rename "${SYS_DIR_64_32}\${CORAL_ID_TSF_X86_DLL}" "${SYS_DIR_64_32}\coraltsf32_$2$1$0$4$5$6.dll"
      Delete /REBOOTOK "${SYS_DIR_64_32}\coraltsf32_$2$1$0$4$5$6.dll"
      ExecWait '${SYS_DIR_64_64}\regsvr32.exe /u /s "${SYS_DIR_64_64}\${CORAL_ID_TSF_X64_DLL}"'
      Rename "${SYS_DIR_64_64}\${CORAL_ID_TSF_X64_DLL}" "${SYS_DIR_64_64}\coraltsf64_$2$1$0$4$5$6.dll"
      Delete /REBOOTOK "${SYS_DIR_64_64}\coraltsf64_$2$1$0$4$5$6.dll"
      Delete /REBOOTOK "${SYS_DIR_64_64}\langengine.dll"
    ${Else}
      ExecWait '${SYS_DIR_32_32}\regsvr32.exe /u /s "${SYS_DIR_32_32}\${CORAL_ID_TSF_X86_DLL}"'
      Rename "${SYS_DIR_32_32}\${CORAL_ID_TSF_X86_DLL}" "${SYS_DIR_32_32}\coraltsf32_$2$1$0$4$5$6.dll"
      Delete /REBOOTOK "${SYS_DIR_32_32}\coraltsf32_$2$1$0$4$5$6.dll"
    ${EndIf}

    ;killer::KillProcess "${CORAL_ID_SETTINGS_EXE}"
	nsExec::ExecToLog 'taskkill /F /IM ${CORAL_ID_SETTINGS_EXE}'
	nsExec::ExecToLog 'taskkill /F /IM ${CORAL_ID_UPDATE_EXE}'
	nsExec::ExecToLog 'taskkill /F /IM ${CORAL_ID_DIAGNOSTIC_EXE}'
	nsExec::ExecToLog 'taskkill /F /IM ${CORAL_ID_SERVICE_EXE}'
	; 释放安装包覆盖时可能被占用的独立引擎与渲染器文件
	nsExec::ExecToLog 'taskkill /F /IM ${CORAL_ID_SESSION_HOST_EXE}'
	nsExec::ExecToLog 'taskkill /F /IM ${CORAL_ID_RENDERER_EXE}'
	Sleep 3000
  ${EndIf}
FunctionEnd

; 说明：把一行文本追加到 $LOG_FILE_PATH 指定的日志文件
; 参数：$0  日志内容
Function WriteLog
  ; 现场保护
  Push $1        ; 文件句柄
  Push $R0       ; 时间串
  Push $R9       ; 日志正文
  Push $R1       ; 时间串
  Push $R2
  Push $R3
  Push $R4
  Push $R5
  Push $R6
  Push $R7
  ClearErrors

  ; $0 是调用者传来的正文，先复制到 $R9
  StrCpy $R9 $0

  ; 空路径直接返回
  DetailPrint "日志路径为空，不写入。"
  StrCmp $LOG_FILE_PATH "" WriteLog_done

  ; 取时间并拼成串
  ${GetTime} "" "L" $R1 $R2 $R3 $R4 $R5 $R6 $R7
  StrCpy $R0 "[$R3-$R2-$R1 $R5:$R6:$R7]"
  
  FileOpen $1 "$LOG_FILE_PATH" a
  StrCmp $1 "" file_open_failed

  ; 写日志：时间 + 正文
  FileSeek $1 0 END
  FileWrite $1 "$R0 $R9$\r$\n"
  FileClose $1
  DetailPrint "日志写入成功: $LOG_FILE_PATH $\r$\n日志内容:$R0 $R9"
  Goto WriteLog_done

file_open_failed:
  MessageBox MB_ICONSTOP "日志文件打开失败: $LOG_FILE_PATH $\r$\n日志文件句柄: $1"
  Goto WriteLog_done

WriteLog_done:
  Pop $R7
  Pop $R6
  Pop $R5
  Pop $R4
  Pop $R3
  Pop $R2
  Pop $R1
  Pop $R9
  Pop $R0
  Pop $1
FunctionEnd

Function CopyFileWithLog
  Pop $R2 ; _TargetFile
  Pop $R1 ; _SourceFile

  StrCpy $R0 "$R2"

  ; 检查目标文件是否存在
  IfFileExists "$R0" 0 try_copy_file

  ; 文件已存在，跳过复制
  StrCpy $0 "信息：文件 '$R0' 已存在，成功！"
  Call WriteLog
  Goto end_function

try_copy_file:
  ; 文件不存在，尝试复制
  StrCpy $0 "目标路径不存在TSF文件，尝试再次复制: $R1 -> $R0"
  MessageBox MB_ICONSTOP|MB_OK $0
  Call WriteLog
  CopyFiles /SILENT "$R1" "$R0"
  IfErrors copy_failed

  ; 复制成功，记录日志
  StrCpy $0 "信息：文件 '$R0' 重新复制成功: $R1 -> $R0"
  MessageBox MB_ICONINFORMATION|MB_OK $0
  Call WriteLog
  Goto end_function

copy_failed:
  ; 复制失败，记录错误并弹窗
  DetailPrint "错误：文件复制失败。无法从 '$R1' 复制到 '$R0'。"
  StrCpy $0 "文件复制失败。无法从 '$R1' 复制到 '$R0'。请检查以下原因：$\n1. 您是否有足够的权限执行此操作？$\n2. 目标文件是否被其他程序占用？$\n3. 源文件是否存在？"
  Call WriteLog
  Goto end_function

end_function:
FunctionEnd
;这个函数作用是：把焦点设置到按钮上，防止快捷键失效
Function SetFocusToButton
  GetDlgItem $0 $HWNDPARENT 1
  SendMessage $HWNDPARENT ${WM_NEXTDLGCTL} $0 1
FunctionEnd

;安装异常处理的时候调用，清理残留标志
Function .onInstFailed
  ; 清理残留标志：HKLM+ HKCU
  DeleteRegValue ${PRODUCT_UNINST_ROOT_KEY_HKLM} "${PRODUCT_UNINST_KEY}" "IsReinstalling"
  DeleteRegValue ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "IsReinstalling"
FunctionEnd
