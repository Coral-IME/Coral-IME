if(NOT DEFINED CASE)
    foreach(case fresh legacy_empty disabled custom invalid)
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${case}" "-DSOURCE_DIR=${SOURCE_DIR}"
            "-DOUTPUT_DIR=${OUTPUT_DIR}/${case}" -P "${CMAKE_CURRENT_LIST_FILE}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(case STREQUAL "invalid")
            if(result EQUAL 0)
                message(FATAL_ERROR "HTTP update service was accepted")
            endif()
        elseif(NOT result EQUAL 0)
            message(FATAL_ERROR "${case}: ${output} ${error}")
        endif()
    endforeach()
    return()
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(CMAKE_CURRENT_BINARY_DIR "${OUTPUT_DIR}")
set(expected "https://coralime.cn")
if(CASE STREQUAL "legacy_empty")
    set(CORAL_UPDATE_SERVICE_BASE_URL "" CACHE STRING "Legacy empty cache" FORCE)
elseif(CASE STREQUAL "disabled")
    set(CORAL_ENABLE_UPDATES OFF CACHE BOOL "Explicit offline build" FORCE)
    set(expected "")
elseif(CASE STREQUAL "custom")
    set(CORAL_UPDATE_SERVICE_BASE_URL "https://updates.example.test/base/" CACHE STRING "Custom endpoint" FORCE)
    set(expected "https://updates.example.test/base")
elseif(CASE STREQUAL "invalid")
    set(CORAL_UPDATE_SERVICE_BASE_URL "http://coralime.cn" CACHE STRING "Invalid endpoint" FORCE)
endif()
include("${SOURCE_DIR}/modules/updates/configure_update_service.cmake")
file(READ "${OUTPUT_DIR}/update_service_config.h" generated)
string(FIND "${generated}" "kUpdateServiceBase[] = \"${expected}\";" found)
if(found EQUAL -1)
    message(FATAL_ERROR "Wrong effective update endpoint: ${generated}")
endif()
if(CASE STREQUAL "disabled" AND CORAL_UPDATES_CONFIGURED)
    message(FATAL_ERROR "Offline build still registers configured updates")
endif()
